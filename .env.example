# Copy this file to .env and fill in the key in order to use the chat.
#
#     cp .env.example .env
#
# Parsing, chunking, embedding, retrieval, and the
# pre-extracted data all run locally with no account and no network.
#
# I accessed my key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. This is where the SQLite database lives. It defaults to data/rag.db.
# RAG_DB_PATH=data/rag.db

# Optional. By setting this the embedding model is forced onto a specific torch device. Detected
# automatically otherwise: cuda, then mps, then cpu.
# RAG_EMBED_DEVICE=cpu
