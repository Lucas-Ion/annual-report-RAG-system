# Copy this file to .env and fill in the key.
#
#     cp .env.example .env
#
# Only the chat needs this. Parsing, chunking, embedding, retrieval, and the
# pre-extracted data all run locally with no account and no network. The
# application starts and the document browser works without a key; asking a
# free-form question is the one thing that does not.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Where the SQLite database lives. Defaults to data/rag.db.
# RAG_DB_PATH=data/rag.db

# Optional. Forces the embedding model onto a specific torch device. Detected
# automatically otherwise: cuda, then mps, then cpu. Worth setting to cpu if
# the GPU is busy with something else.
# RAG_EMBED_DEVICE=cpu
